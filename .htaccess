Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------- One canonical address: https://www.hicadsystemsltd.com ----------
# Search engines treat http/https and www/non-www as different sites, so everything is
# sent (permanently) to the secure www address. If you ever move the site to another
# domain, change the domain name in the two "RewriteRule" lines below.
# Turn this block off by putting a "#" at the start of each line if HTTPS stops working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # 1. Insecure (http) -> https. The X-Forwarded-Proto line keeps this working behind a CDN or proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.hicadsystemsltd.com%{REQUEST_URI} [L,R=301]
  # 2. Without "www" -> with "www".
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.hicadsystemsltd.com%{REQUEST_URI} [L,R=301]
  # 3. /index.html and /about/index.html -> /  and  /about/  (no duplicate pages).
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ https://www.hicadsystemsltd.com/$1 [L,R=301]
</IfModule>

# Optional, once you are sure HTTPS will stay on: tells browsers to always use https.
# Remove the "#" to enable. It is hard to undo once browsers have remembered it.
# <IfModule mod_headers.c>
#   Header always set Strict-Transport-Security "max-age=31536000"
# </IfModule>

# ---------- Speed (a ranking factor) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/ld+json application/manifest+json application/xml text/xml image/svg+xml image/x-icon
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/x-icon "access plus 90 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 90 days"
  ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

AddType application/manifest+json .webmanifest

# Keep the setup notes out of search results.
<IfModule mod_authz_core.c>
  <Files "README.md">
    Require all denied
  </Files>
</IfModule>
